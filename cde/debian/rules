#!/usr/bin/make -f
export DH_VERBOSE = 1
DEB_HOST_MULTIARCH ?= $(shell dpkg-architecture -qDEB_HOST_MULTIARCH)

%:
	dh $@

override_dh_auto_configure:
	./autogen.sh
	dh_auto_configure -- --prefix=/usr

override_dh_auto_build:
	dh_auto_build

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	set -e; \
	LDLP="$$(find $(CURDIR) -type d -name .libs -print | paste -sd: -)"; \
	echo "LD_LIBRARY_PATH=$$LDLP"; \
	LD_LIBRARY_PATH="$$LDLP$${LD_LIBRARY_PATH:+:$$LD_LIBRARY_PATH}" dh_auto_test --no-parallel
else
	@echo "Skipping tests because DEB_BUILD_OPTIONS contains nocheck"
endif

override_dh_auto_install:
	dh_auto_install
	for d in debian/tmp debian/cde-desktop; do \
		if [ -d "$$d" ]; then \
			find "$$d" -type f -exec sed -i '1s|^#![[:space:]]*/usr/bin/ksh[[:space:]]*$$|#!/bin/ksh|' {} +; \
			find "$$d" -type f -exec sed -i '1s|^#![[:space:]]*/usr/dt/bin/dtksh[[:space:]]*$$|#!/usr/bin/dtksh|' {} +; \
		fi; \
	done
	for d in debian/tmp debian/cde-desktop; do \
		if [ -d "$$d/usr/share/man/man1m" ]; then \
			install -d "$$d/usr/share/man/man8"; \
			for f in "$$d"/usr/share/man/man1m/*.1m; do \
				[ -e "$$f" ] || continue; \
				base="$$(basename "$$f" .1m)"; \
				perl -0pi -e 's/^(\.TH\s+(?:"[^"]+"|\S+)\s+)(?:"[^"]+"|\S+)/$${1}"8"/im' "$$f"; \
				mv "$$f" "$$d/usr/share/man/man8/$$base.8"; \
			done; \
			rmdir --ignore-fail-on-non-empty "$$d/usr/share/man/man1m"; \
		fi; \
	done
	for d in debian/tmp debian/cde-desktop; do \
		if [ -d "$$d/usr/share/man/man8" ]; then \
			ln -sf ttdbserver.8.gz "$$d/usr/share/man/man8/rpc.ttdbserver.8.gz"; \
		fi; \
	done
	for d in debian/tmp debian/cde-desktop; do \
		if [ -d "$$d/usr/share/man/man1" ]; then \
			ln -sf dthelpgen.1.gz "$$d/usr/share/man/man1/dthelpgen.dtsh.1.gz"; \
			ln -sf dthelpprint.1.gz "$$d/usr/share/man/man1/dthelpprint.sh.1.gz"; \
		fi; \
	done
	for d in debian/tmp debian/cde-desktop; do \
		if [ -d "$$d" ]; then \
			find "$$d" -name '*.la' -type f -exec sed -i "s|^dependency_libs=.*|dependency_libs=''|" {} +; \
		fi; \
	done
	for d in debian/tmp debian/cde-desktop; do \
		if [ -d "$$d" ]; then \
			rm -f "$$d/usr/dt/COPYING" "$$d/usr/dt/copyright"; \
			if [ -f "$$d/usr/dt/README.md" ]; then \
				install -d "$$d/usr/share/doc/cde-desktop"; \
				mv "$$d/usr/dt/README.md" "$$d/usr/share/doc/cde-desktop/README.upstream.md"; \
			fi; \
		fi; \
	done
	for d in debian/tmp debian/cde-desktop; do \
		if [ -d "$$d" ]; then \
			chmod 0644 "$$d/usr/dt/config/sys.dtprofile" 2>/dev/null || true; \
			chmod 0644 "$$d/usr/lib/$(DEB_HOST_MULTIARCH)/dtksh/DtFuncs.dtsh" 2>/dev/null || true; \
		fi; \
	done
	for d in debian/tmp debian/cde-desktop; do \
		if [ -d "$$d" ]; then \
			rm -f "$$d/usr/share/terminfo/d/dtterm"; \
			rmdir --ignore-fail-on-non-empty "$$d/usr/share/terminfo/d" 2>/dev/null || true; \
			rmdir --ignore-fail-on-non-empty "$$d/usr/share/terminfo" 2>/dev/null || true; \
		fi; \
	done

execute_after_dh_fixperms:
	chmod 1777 debian/cde-desktop/var/dt/appconfig/appmanager
