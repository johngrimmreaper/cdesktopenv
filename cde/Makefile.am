docsdir = $(CDE_INSTALLATION_TOP)
docs_DATA = CONTRIBUTORS COPYING copyright HISTORY README.md

MAINTAINERCLEANFILES = Makefile.in \
		configure libtool \
		config.guess \
		config.sub \
		config.log \
		config.h.in \
		install-sh

SUBDIRS = util lib programs include

# Some files included in release tarballs are generated by helper programs
# built from this source tree. Build the tree before creating the dist
# directory so those generated files and helpers are available.
dist: all

if BUILD_DOCS
SUBDIRS += doc
endif

EXTRA_DIST = \
    CONTRIBUTORS \
    HISTORY
