BUILT_SOURCES = $(DTTYPES) action
PATH_TMSG = _common.dt.tmsg.paths
CLEANFILES = $(BUILT_SOURCES) $(PATH_TMSG)
EXTRA_DIST = _common.dt.tmsg

# we do not want to install 'action'
typesdir = $(CDE_DATA_TOP)/appconfig/types/$(LANG)
dist_types_DATA = $(DTTYPES)

TOP = $(top_builddir)/programs
MERGE = $(top_builddir)/programs/localized/util/merge

LOCALIZED_PATH_SUBST = $(SED) \
	-e 's|__CDE_DATA_TOP__|$(CDE_DATA_TOP)|g' \
	-e 's|__CDE_CONFIGURATION_TOP__|$(CDE_CONFIGURATION_TOP)|g' \
	-e 's|__CDE_LOGFILES_TOP__|$(CDE_LOGFILES_TOP)|g'

$(PATH_TMSG): $(srcdir)/_common.dt.tmsg
	$(LOCALIZED_PATH_SUBST) $< > $@ || { $(RM) $@; exit 1; }

# This isn't really an action/type - it's an executable placeholder
# used by and for appmanager.
action: $(TOP)/types/action action.tmsg
	$(MERGE) -lang $(LANG) action.tmsg < $< > $@ || $(RM) $@

